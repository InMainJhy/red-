PORT=3030
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/time_persona
TARGET_MODEL=gpt-5.4
REASONING_EFFORT=xhigh
FALLBACK_MODEL=claude-opus-4-6
FALLBACK_EFFORT=max
DEFAULT_LIBRARY_DIR=/Users/mychanging/Desktop/知识库收集
IMPORT_ON_BOOT=true
MAX_IMPORT_SECTIONS=8

# DeepSeek / OpenAI API 配置
# 在宝塔面板中设置环境变量
DEEPSEEK_API_KEY=your-deepseek-api-key-here
# 或者使用 OpenAI API Key
# OPENAI_API_KEY=your-openai-api-key-here

# API 基础地址 (可选，默认使用 DeepSeek)
LLM_BASE_URL=https://api.deepseek.com

# 模型名称 (可选，默认 deepseek-chat)
LLM_MODEL=deepseek-chat
